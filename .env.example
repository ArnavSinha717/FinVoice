# ── FinVoice environment ──
# Copy to .env and fill in. Everything here is optional except HF_TOKEN,
# without which speaker diarization is skipped (see README).

# HuggingFace token — REQUIRED for pyannote speaker diarization.
# Create at https://huggingface.co/settings/tokens, then accept the model terms at:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
# Without it the pipeline still runs, but every speaker-derived feature degrades:
# agent/customer talk %, per-speaker emotion, agent-domination and third-party
# disclosure compliance checks.
HF_TOKEN=

# HuggingFace download timeout, in seconds. Without this, a stalled model
# download blocks a pipeline stage indefinitely — the dashboard sits on
# "Stage 4A" forever with no error. Pre-warm with scripts/warmup_models.py.
HF_HUB_DOWNLOAD_TIMEOUT=30

# API authentication. Unset = every endpoint is open, including transcripts,
# PII and call audio. Set any random string to require an X-API-Key header.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FINVOICE_API_KEY=

# LLM used for extraction. MUST be a non-reasoning model — reasoning models
# (qwen3:*, qwen3.5:*) return an empty response through Ollama's OpenAI endpoint.
FINVOICE_LLM_MODEL=qwen2.5:3b

# Languages to warm wav2vec2 alignment models for. WhisperX downloads one per
# language at transcription time; a cold Hindi call otherwise stalls in Stage 3.
FINVOICE_ALIGN_LANGUAGES=en,hi,ta

# emotion2vec device. "auto" uses the GPU when there is enough free VRAM and
# falls back to CPU otherwise; "cpu" or "cuda" force the choice. On GPU this is
# the difference between ~30-60s and a few seconds per call.
FINVOICE_EMOTION_DEVICE=auto

# Ollama endpoint for local LLM extraction and the AI Analyst.
# Requires `ollama pull qwen2.5:3b` and `ollama pull qwen3:8b`.
OLLAMA_URL=http://localhost:11434

# Frontend: point the dashboard at a non-default backend host/port.
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
